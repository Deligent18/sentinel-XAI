# ============================================================================
# Sentinel XAI — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# REQUIRED: Secret key for JWT token signing
# Generate a strong one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=xai-sentinel-change-me-in-production

# Environment: development | production | ci
ENVIRONMENT=production

# Dataset generation settings
NUM_STUDENTS=1200
DATA_SEED=42

# Optional: MySQL database (leave blank to use CSV mode)
# DB_HOST=db
# DB_PORT=3306
# DB_USER=sentinel
# DB_PASSWORD=your-db-password
# DB_NAME=sentinel_xai
# DB_ROOT_PASSWORD=your-root-password
